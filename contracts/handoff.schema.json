{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "task-contract",
        "system-investigation",
        "interface-design",
        "change-impact",
        "behavioral-testing",
        "fault-diagnosis",
        "measured-optimisation",
        "independent-review",
        "browser-verification",
        "delivery-evidence"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "kind",
    "revision",
    "status",
    "summary",
    "payload",
    "evidence",
    "limitations",
    "next_actions"
